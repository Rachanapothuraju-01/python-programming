
# Text-Based Invoice Data Extraction

n = int(input("Enter number of invoice records: "))

for i in range(n):
    record = input("Enter invoice record: ")

    parts = record.split(",")

    if len(parts) == 3:
        code = parts[0].strip()
        quantity = parts[1].strip()
        amount = parts[2].strip()

        if (code.isalnum() and
            quantity.isdigit() and
            amount.replace(".", "", 1).isdigit() and
            float(amount) >= 0 and
            int(quantity) > 0):

            print("\nValid Invoice Record")
            print("Product Code:", code)
            print("Quantity:", quantity)
            print("Amount: Rs.", amount)

        else:
            print("\nMalformed Record:", record)

    else:
        print("\nMalformed Record:", record)

